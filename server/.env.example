NODE_ENV=development
PORT=5000
API_HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
# Comma-separated additional browser origins, if needed.
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT_MAX=200
LOGIN_IP_FAILURE_LIMIT=100
# Use this local URI for development, or replace it with your Atlas connection URI.
MONGO_URI=mongodb://127.0.0.1:27017/safelink
JWT_SECRET=replace-with-a-long-random-secret
# Optional separate secret used to protect login-state records.
LOGIN_STATE_SECRET=replace-with-a-second-long-random-login-state-secret
APP_URL=http://localhost:5000
# Local development paths. Production evidence uses Cloudinary instead.
EVIDENCE_UPLOAD_DIR=
AUDIT_OUTBOX_DIR=
# HTTPS email delivery, required in production (SMTP is blocked on Render Free).
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=SafeLink <onboarding@your-verified-domain.example>
# Required in production for protected, persistent evidence uploads.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
INITIAL_ADMIN_FIRSTNAME=SafeLink
INITIAL_ADMIN_LASTNAME=Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PHONE=09171234567
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
