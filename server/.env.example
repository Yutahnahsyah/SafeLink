NODE_ENV=development
PORT=5000
API_HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
# Comma-separated additional browser origins, if needed.
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT_MAX=200
LOGIN_IP_FAILURE_LIMIT=100
# Use this local URI for development, or replace it with your Atlas connection URI.
MONGO_URI=mongodb://127.0.0.1:27017/safelink
JWT_SECRET=replace-with-a-long-random-secret
# Optional separate secret used to protect login-state records.
LOGIN_STATE_SECRET=replace-with-a-second-long-random-login-state-secret
APP_URL=http://localhost:5000
# Persist evidence and audit-recovery records on a mounted production disk.
EVIDENCE_UPLOAD_DIR=
AUDIT_OUTBOX_DIR=
# Configure SMTP only if password-reset email is enabled.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
INITIAL_ADMIN_FIRSTNAME=SafeLink
INITIAL_ADMIN_LASTNAME=Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PHONE=09171234567
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
