        { "name": "PATCH Assign/referral to Barangay", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"assignedAgency\": \"Barangay\", \"assignedPersonnel\": \"{{barangayId}}\", \"remarks\": \"LGU referred verified report.\" }" }, "url": "{{baseUrl}}/api/incidents/{{barangayIncidentId}}/process" }, "response": [] },
        { "name": "POST Upload evidence", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "evidence", "type": "file", "src": "{{evidenceFile}}" }] }, "url": "{{baseUrl}}/api/incidents/{{lguIncidentId}}/evidence" }, "response": [] },
        { "name": "GET Download evidence", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/{{lguIncidentId}}/evidence/{{evidenceId}}" }, "response": [] },
        { "name": "GET Municipality safety map", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map" }, "response": [] },
        { "name": "GET Pangasinan boundary", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map/boundary" }, "response": [] },
        { "name": "GET Notifications", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications" }, "response": [] },
        { "name": "PATCH Mark notification read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }, "response": [] },
        { "name": "PATCH Mark all notifications read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" }, "response": [] },
        { "name": "GET Municipality analytics", "request": { "method": "GET", "url": "{{baseUrl}}/api/analytics/overview" }, "response": [] }
      ]
    },
