      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{barangayToken}}", "type": "string" }] },
      "item": [
        { "name": "GET View assigned incidents", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents" }, "response": [] },
        { "name": "PATCH Process assigned incident", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"In Progress\", \"remarks\": \"Barangay response underway.\" }" }, "url": "{{baseUrl}}/api/incidents/{{barangayIncidentId}}/process" }, "response": [] },
        { "name": "POST Upload evidence", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "evidence", "type": "file", "src": "{{evidenceFile}}" }] }, "url": "{{baseUrl}}/api/incidents/{{barangayIncidentId}}/evidence" }, "response": [] },
