    {
      "name": "05 Citizen — reporting and tracking",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{citizenToken}}", "type": "string" }] },
      "item": [
        { "name": "POST Submit incident", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('201 Incident created', () => pm.expect(pm.response.code).to.equal(201));", "pm.environment.set('incidentId', body.incident._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"incidentType\": \"Suspicious activities\", \"description\": \"A complete test report with enough information for validation.\", \"location\": { \"address\": { \"barangay\": \"Poblacion\", \"municipalityOrCity\": \"Lingayen\" }, \"latitude\": 16.021, \"longitude\": 120.233 } }" }, "url": "{{baseUrl}}/api/incidents" }, "response": [] },
        { "name": "GET View own incidents", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents" }, "response": [] },
        { "name": "POST Upload own evidence", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "evidence", "type": "file", "src": "{{evidenceFile}}" }] }, "url": "{{baseUrl}}/api/incidents/{{incidentId}}/evidence" }, "response": [] },
        { "name": "GET Download own evidence", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/{{incidentId}}/evidence/{{evidenceId}}" }, "response": [] },
        { "name": "GET Community safety map", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map?status=Verified,In%20Progress&severity=High,Critical" }, "response": [] },
        { "name": "GET Pangasinan boundary", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map/boundary" }, "response": [] },
        { "name": "GET Notifications", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications?read=false&page=1&limit=25" }, "response": [] },
        { "name": "PATCH Mark notification read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }, "response": [] },
        { "name": "PATCH Mark all notifications read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" }, "response": [] },
        { "name": "GET Community analytics", "request": { "method": "GET", "url": "{{baseUrl}}/api/analytics/overview" }, "response": [] }
      ]
    },
    {
      "name": "06 Security and Rate Limits",
      "description": "Restart the local server before intentional rate-limit tests. Run the API-limit request 301 times in Collection Runner. Set wrongLoginAttempt to 0, then run the wrong-password request six times; its sixth response must be 429.",
      "item": [
        {
          "name": "GET Check Helmet security headers",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 is returned for an unknown API route', () => pm.expect(pm.response.code).to.equal(404));", "pm.test('X-Content-Type-Options is nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff'));", "pm.test('X-Frame-Options is SAMEORIGIN', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.equal('SAMEORIGIN'));", "pm.test('Content-Security-Policy is present', () => pm.expect(pm.response.headers.get('Content-Security-Policy')).to.exist);", "pm.test('RateLimit metadata is present', () => pm.expect(pm.response.headers.get('RateLimit')).to.exist);"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/not-a-route" },
          "response": []
        },
        {
          "name": "GET API limit — expected 429 after 300 requests",
          "description": "Run this request 301 times in Collection Runner. Requests 1–300 are 404; request 301 is 429.",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Response is normal or throttled', () => pm.expect([404, 429]).to.include(pm.response.code));", "if (pm.response.code === 429) pm.test('API limiter is enforced', () => pm.expect(pm.response.json().message).to.include('Too many requests'));" ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/not-a-route" },
          "response": []
        },
        {
          "name": "POST Wrong password lockout — run 6 times",
          "description": "Set wrongLoginAttempt to 0 first. Attempts 1–5 return 400; attempt 6 returns 429 and is blocked for 15 minutes. Successful logins are excluded from this limiter.",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const attempt = Number(pm.environment.get('wrongLoginAttempt') || 0) + 1;", "pm.environment.set('wrongLoginAttempt', attempt);"] } },
            { "listen": "test", "script": { "exec": ["const attempt = Number(pm.environment.get('wrongLoginAttempt'));", "if (attempt < 6) pm.test('Wrong credentials return 400', () => pm.expect(pm.response.code).to.equal(400));", "if (attempt === 6) pm.test('Sixth failed login returns 429', () => pm.expect(pm.response.code).to.equal(429));"] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{adminEmail}}\", \"password\": \"WrongPassword1!\" }" }, "url": "{{baseUrl}}/api/auth/login" },
          "response": []
        }
      ]
    },
    {
      "name": "99 Destructive cleanup — run last only",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        { "name": "DELETE Test user as Admin", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/auth/users/{{personnelId}}" }, "response": [] },
        { "name": "DELETE Own-city user as LGU", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{lguToken}}", "type": "string" }] }, "request": { "method": "DELETE", "url": "{{baseUrl}}/api/auth/users/{{personnelId}}" }, "response": [] }
      ]
    }
  ]
}
