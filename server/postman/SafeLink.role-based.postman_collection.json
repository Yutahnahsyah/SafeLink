{
  "info": {
    "_postman_id": "ec2cb3d0-2e2c-48df-ab43-5554c79e0d28",
    "name": "SafeLink API — Role-Based Test Matrix",
    "description": "Complete role-based test collection. Select the SafeLink Local environment, enter credentials and IDs, then run folders from top to bottom. Requests use inherited folder authentication. The destructive cleanup folder must run last.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Public setup and sessions",
      "item": [
        { "name": "POST Register citizen", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Juan\", \"lastName\": \"Dela Cruz\", \"middleInitial\": \"S\",\n  \"email\": \"{{citizenEmail}}\", \"password\": \"{{citizenPassword}}\", \"phoneNumber\": \"09171234567\",\n  \"address\": { \"barangay\": \"Poblacion\", \"municipalityOrCity\": \"Lingayen\" }\n}" }, "url": "{{baseUrl}}/api/auth/register-citizen" }, "response": [] },
        { "name": "GET Verify citizen email", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/verify-email/{{verificationToken}}" }, "response": [] },
        { "name": "POST Request password reset email", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{citizenEmail}}\" }" }, "url": "{{baseUrl}}/api/auth/forgot-password" }, "response": [] },
        { "name": "POST Reset password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"password\": \"NewPassword1!\" }" }, "url": "{{baseUrl}}/api/auth/reset-password/{{resetToken}}" }, "response": [] },
        { "name": "POST Login Admin", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 Admin login', () => pm.expect(pm.response.code).to.equal(200));", "pm.environment.set('adminToken', body.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\" }" }, "url": "{{baseUrl}}/api/auth/login" }, "response": [] },
        { "name": "POST Login LGU", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 LGU login', () => pm.expect(pm.response.code).to.equal(200));", "pm.environment.set('lguToken', body.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{lguEmail}}\", \"password\": \"{{lguPassword}}\" }" }, "url": "{{baseUrl}}/api/auth/login" }, "response": [] },
        { "name": "POST Login Barangay", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 Barangay login', () => pm.expect(pm.response.code).to.equal(200));", "pm.environment.set('barangayToken', body.token);", "pm.environment.set('barangayId', body.user.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{barangayEmail}}\", \"password\": \"{{barangayPassword}}\" }" }, "url": "{{baseUrl}}/api/auth/login" }, "response": [] },
        { "name": "POST Login Police", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 Police login', () => pm.expect(pm.response.code).to.equal(200));", "pm.environment.set('policeToken', body.token);", "pm.environment.set('policeId', body.user.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{policeEmail}}\", \"password\": \"{{policePassword}}\" }" }, "url": "{{baseUrl}}/api/auth/login" }, "response": [] },
        { "name": "POST Login Citizen", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 Citizen login', () => pm.expect(pm.response.code).to.equal(200));", "pm.environment.set('citizenToken', body.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"{{citizenEmail}}\", \"password\": \"{{citizenPassword}}\" }" }, "url": "{{baseUrl}}/api/auth/login" }, "response": [] }
      ]
    },
    {
      "name": "01 Admin — global oversight",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        { "name": "POST Create Barangay personnel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"firstName\": \"Maria\", \"lastName\": \"Santos\", \"email\": \"{{barangayEmail}}\", \"password\": \"{{barangayPassword}}\", \"role\": \"barangay_personnel\", \"phoneNumber\": \"09171234568\", \"jurisdiction\": { \"barangay\": \"Poblacion\", \"municipalityOrCity\": \"Lingayen\" } }" }, "url": "{{baseUrl}}/api/auth/register-personnel" }, "response": [] },
        { "name": "POST Create LGU personnel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"firstName\": \"Liza\", \"lastName\": \"Garcia\", \"email\": \"{{lguEmail}}\", \"password\": \"{{lguPassword}}\", \"role\": \"lgu_personnel\", \"phoneNumber\": \"09171234569\", \"jurisdiction\": { \"municipalityOrCity\": \"Lingayen\" } }" }, "url": "{{baseUrl}}/api/auth/register-personnel" }, "response": [] },
        { "name": "POST Create Police personnel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"firstName\": \"Pedro\", \"lastName\": \"Reyes\", \"email\": \"{{policeEmail}}\", \"password\": \"{{policePassword}}\", \"role\": \"police_personnel\", \"phoneNumber\": \"09171234570\", \"jurisdiction\": { \"municipalityOrCity\": \"Lingayen\" } }" }, "url": "{{baseUrl}}/api/auth/register-personnel" }, "response": [] },
        { "name": "GET Pending personnel", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/pending-personnel" }, "response": [] },
        { "name": "PUT Approve pending personnel", "request": { "method": "PUT", "url": "{{baseUrl}}/api/auth/approve-personnel/{{pendingPersonnelId}}" }, "response": [] },
        { "name": "GET Available personnel", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/personnel" }, "response": [] },
        { "name": "PATCH Set user status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"active\" }" }, "url": "{{baseUrl}}/api/auth/users/{{personnelId}}/status" }, "response": [] },
        { "name": "GET View all incidents", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents" }, "response": [] },
        { "name": "PATCH Process incident", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Under Validation\", \"remarks\": \"Admin validation started.\" }" }, "url": "{{baseUrl}}/api/incidents/{{adminIncidentId}}/process" }, "response": [] },
        { "name": "PATCH Assign/referral to Police", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"assignedAgency\": \"Police\", \"assignedPersonnel\": \"{{policeId}}\", \"remarks\": \"Verified report referred to Police.\" }" }, "url": "{{baseUrl}}/api/incidents/{{policeIncidentId}}/process" }, "response": [] },
        { "name": "POST Upload evidence", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "evidence", "type": "file", "src": "{{evidenceFile}}" }] }, "url": "{{baseUrl}}/api/incidents/{{adminIncidentId}}/evidence" }, "response": [] },
        { "name": "GET Download evidence", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/{{adminIncidentId}}/evidence/{{evidenceId}}" }, "response": [] },
        { "name": "GET Safety map", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map" }, "response": [] },
        { "name": "GET Pangasinan boundary", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map/boundary" }, "response": [] },
        { "name": "GET Notifications", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications" }, "response": [] },
        { "name": "PATCH Mark notification read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }, "response": [] },
        { "name": "PATCH Mark all notifications read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" }, "response": [] },
        { "name": "GET Audit logs", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/audit-logs?action=AUTH_LOGIN&outcome=success&page=1&limit=25" }, "response": [] },
        { "name": "GET Analytics overview", "request": { "method": "GET", "url": "{{baseUrl}}/api/analytics/overview" }, "response": [] }
      ]
    },
    {
