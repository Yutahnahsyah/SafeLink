    {
      "name": "04 Police — assigned incident work",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{policeToken}}", "type": "string" }] },
      "item": [
        { "name": "GET View assigned incidents", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents" }, "response": [] },
        { "name": "PATCH Process assigned incident", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"In Progress\", \"remarks\": \"Police response underway.\" }" }, "url": "{{baseUrl}}/api/incidents/{{policeIncidentId}}/process" }, "response": [] },
        { "name": "POST Upload evidence", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "evidence", "type": "file", "src": "{{evidenceFile}}" }] }, "url": "{{baseUrl}}/api/incidents/{{policeIncidentId}}/evidence" }, "response": [] },
        { "name": "GET Download evidence", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/{{policeIncidentId}}/evidence/{{evidenceId}}" }, "response": [] },
        { "name": "GET Municipality safety map", "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/map" }, "response": [] },
